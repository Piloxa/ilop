{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilop.ai/schema/ilop-proof.schema.json",
  "title": "ILOP v0.2 Proof (one evidence item)",
  "type": "object",
  "required": ["type", "claim", "issuer", "status", "source"],
  "properties": {
    "proof_id": { "type": "string" },
    "type": { "type": "string", "minLength": 1, "description": "One of the action's proof_types, or verification_page." },
    "claim": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1, "description": "Who asserts this item. A provider relaying carrier data is the issuer; the carrier is not." },
    "status": { "enum": ["RECORDED", "REPORTED", "PENDING", "NOT_AVAILABLE", "AVAILABLE", "REVOKED"] },
    "value": { "type": ["string", "null"] },
    "occurred_at": { "$ref": "ilop-common.schema.json#/$defs/nullableTimestamp" },
    "observed_at": { "$ref": "ilop-common.schema.json#/$defs/timestamp" },
    "subject": { "type": "object", "properties": { "content_sha256": { "$ref": "ilop-common.schema.json#/$defs/sha256" }, "destination_digest": { "type": "string" } } },
    "source": { "$ref": "ilop-common.schema.json#/$defs/source" },
    "verify_url": { "type": "string", "format": "uri" },
    "signature": {
      "type": "object",
      "description": "Present only when the issuer signed this item. A provider signature proves the provider said it, not that the carrier did.",
      "required": ["format", "key_id", "key_url", "value"],
      "properties": { "format": { "enum": ["jws-detached-ed25519"] }, "key_id": { "type": "string" }, "key_url": { "type": "string", "format": "uri" }, "value": { "type": "string" } }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "PENDING" } } }, "then": { "properties": { "value": { "type": "null" } } } }
  ]
}
