{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilop.ai/schema/ilop-manifest.schema.json",
  "title": "ILOP discovery file (/.well-known/ilop.json), v0.1",
  "type": "object",
  "required": ["ilop_version", "provider", "mcp", "actions", "tools", "approval"],
  "properties": {
    "ilop_version": { "type": "string", "pattern": "^0\\.1$" },
    "provider": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "operator": { "type": "string" }
      }
    },
    "mcp": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "auth": { "type": "string", "enum": ["none", "oauth"] }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "proof_types"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$" },
          "title": { "type": "string" },
          "region": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "proof_types": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "tools": {
      "type": "object",
      "required": ["quote", "prepare", "status"],
      "properties": {
        "quote": { "type": "string" },
        "check": { "type": "string" },
        "prepare": { "type": "string" },
        "authorize": { "type": "string" },
        "status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["hosted_page"],
      "properties": {
        "hosted_page": { "type": "boolean" },
        "in_chat": { "type": "array", "items": { "type": "string", "enum": ["acp", "ap2", "stripe_shared_payment_token"] } }
      }
    },
    "verify_url": { "type": "string", "format": "uri" }
  }
}
